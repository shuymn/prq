{
  "name": "@prq/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --no-compile-autoload-tsconfig --no-compile-autoload-package-json src/main.ts --outfile dist/prq",
    "stack": "node src/test/local-stack.ts",
    "check:cloud": "node src/test/cloud-check.ts",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@prq/protocol": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "jose": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": "24.x"
  }
}
