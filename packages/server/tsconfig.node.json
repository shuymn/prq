// What runs in Node, with Node's types, outside the Worker's runtime types: the Node test project's tests
// (vitest.config.ts), the web UI's build (vite.config.ts, build/), and the host's operations commands (the scripts
// listed below).
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "src/**/*.node.test.ts",
    "vite.config.ts",
    "build",
    "scripts/secrets.ts",
    "scripts/operations.ts",
    "scripts/release-check.ts",
    "scripts/deploy.ts",
    "scripts/setup.ts",
    "scripts/test-terminal.ts",
    "scripts/setup-host.ts",
    "scripts/setup-state.ts",
    "scripts/setup-run.ts",
    "scripts/setup-terminal.ts",
    "scripts/setup-github-app.ts",
    "scripts/github-stand-in.ts",
    "scripts/first-deploy.ts",
    "scripts/worker-secrets.ts",
    "scripts/**/*.node.test.ts"
  ]
}
