{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "scripts", "vitest.config.ts"],
  // Run in Node, checked by tsconfig.node.json; the web UI runs in the browser, checked by tsconfig.client.json.
  "exclude": [
    "src/**/*.node.test.ts",
    "scripts/secrets.ts",
    "scripts/operations.ts",
    "scripts/release-check.ts",
    "scripts/deploy.ts",
    "scripts/setup.ts",
    "scripts/test-terminal.ts",
    "scripts/setup-host.ts",
    "scripts/setup-cloudflare.ts",
    "scripts/cloudflare-api.ts",
    "scripts/setup-state.ts",
    "scripts/setup-run.ts",
    "scripts/setup-terminal.ts",
    "scripts/setup-github-app.ts",
    "scripts/github-stand-in.ts",
    "scripts/worker-secrets.ts",
    "scripts/**/*.node.test.ts",
    "src/client"
  ]
}
