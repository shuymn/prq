{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "scripts", "vitest.config.ts"],
  // Run in Node, checked by tsconfig.node.json; the web UI runs in the browser, checked by tsconfig.client.json.
  "exclude": ["src/**/*.node.test.ts", "scripts/secrets.ts", "scripts/**/*.node.test.ts", "src/client"]
}
