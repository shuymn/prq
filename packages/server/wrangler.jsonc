// The Worker's configuration. Secrets (ACCESS_TEAM_DOMAIN, ACCESS_AUD; src/env.d.ts) are set outside this file.
{
  "name": "prq",
  "main": "src/index.ts",
  // No later than the workerd that @cloudflare/vitest-plugin bundles.
  "compatibility_date": "2026-11-10",
  // The Agents SDK needs the Node.js APIs.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "Hub", "class_name": "Hub" },
      { "name": "PrSession", "class_name": "PrSession" },
    ],
  },
  // The Agents SDK keeps its state in SQLite, so both classes are SQLite-backed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub", "PrSession"] }],
  "observability": {
    "enabled": true,
  },
}
