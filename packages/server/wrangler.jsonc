// The Worker's configuration. Secrets (ACCESS_TEAM_DOMAIN, ACCESS_AUD, WEBHOOK_SECRET, HOST_GITHUB_ID; src/env.d.ts)
// are set outside this file.
{
  "name": "prq",
  "main": "src/index.ts",
  // No later than the workerd that @cloudflare/vitest-plugin bundles.
  "compatibility_date": "2026-11-10",
  // The Agents SDK needs the Node.js APIs. enable_request_signal (the default from 2026-11-17, later than the date
  // above) fires an incoming request's signal when its client goes away: the Hub ends a wait whose agent left with it.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "durable_objects": {
    "bindings": [
      { "name": "Hub", "class_name": "Hub" },
      { "name": "PrSession", "class_name": "PrSession" },
      { "name": "Workspace", "class_name": "Workspace" },
    ],
  },
  // The Agents SDK keeps its state in SQLite, so both classes are SQLite-backed; the Workspace keeps its turn
  // sequence and ready record there too.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub", "PrSession"] },
    { "tag": "v2", "new_sqlite_classes": ["Workspace"] },
  ],
  // The cloud workspace's container (src/workspace.ts, Dockerfile): one per session, on the basic instance type.
  "containers": [{ "class_name": "Workspace", "image": "./Dockerfile", "instance_type": "basic" }],
  // Tests and `wrangler dev` run without Docker: the vitest pool and wrangler's test harness read this, and the
  // Workspace then has no container. The owner's check (`pnpm run check:workspace` in packages/cli, AGENTS.md) runs it
  // with Docker through an inline copy of this config that turns containers on (packages/cli/src/test/worker.ts).
  "dev": { "enable_containers": false },
  // The web UI, built by `pnpm run build` (vite.config.ts) with its `_headers` (docs/design.md, Caching). A path that is
  // no file gets the shell, so the client's routes load it; the Worker's own routes reach the Worker first, a browser's
  // navigation included, which the fallback would otherwise answer with the shell. `/index.html` redirects to `/`.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*", "/cli/*", "/webhook", "/webhook/*"],
  },
  "observability": {
    "enabled": true,
  },
}
