  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{palette.gray.950}"
      },
      "subtle": {
        "$value": "{palette.gray.900}"
      },
      "muted": {
        "$value": "{palette.gray.800}"
      },
      "overlay": {
        "$value": "{palette.gray.900}"
      },
      "backdrop": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0039, 0.0157, 0.0353],
          "alpha": 0.7
        }
      }
    },
    "fg": {
      "default": {
        "$value": "{palette.gray.100}"
      },
      "muted": {
        "$value": "{palette.gray.300}"
      },
      "on-emphasis": {
        "$value": "{palette.white}"
      },
      "disabled": {
        "$value": "{palette.gray.500}"
      }
    },
    "border": {
      "default": {
        "$value": "{palette.gray.600}"
      },
      "muted": {
        "$value": "{palette.gray.700}"
