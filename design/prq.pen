                    "AZMDZ": {
                      "content": "shuymn/prq #42"
                    },
                    "z9c52": {
                      "content": "Add retry to stalled jobs"
                    }
                  }
                },
                {
                  "id": "VmaGq",
                  "type": "ref",
                  "ref": "jTRJl",
                  "name": "Summary",
                  "width": "fill_container",
                  "descendants": {
                    "aXYUE/nVVeD": {
                      "content": "e4f5a6b"
                    },
                    "OtDD8/qnZ4a": {
                      "content": "12 min ago"
                    },
                    "IIGC4": {
                      "content": "deepseek-chat · 12,480 tokens"
                    },
                    "G5aTKs/y5inXt": {
                      "content": "What changed"
                    },
                    "G5aTKs/J91by": {
                      "content": "Jobs that an agent claimed but never finished can now be retried from the UI. A retry puts the job back to pending and issues a new claim ID, so a late result from the old claim is dropped."
                    },
                    "G5aTKs/raSAP": {
                      "content": "Retries go through"
                    },
                    "G5aTKs/RNlph": {
                      "content": "resetClaim()"
                    },
                    "G5aTKs/U5zfrF": {
                      "content": "as described in"
                    },
                    "G5aTKs/JmYFs": {
                      "content": "the design doc"
                    },
                    "G5aTKs/T4nLw": {
                      "content": "Risks"
                    },
                    "G5aTKs/X03nbO": {
                      "content": "A retry while the first agent is still working costs one extra run."
                    },
                    "G5aTKs/KzZf6": {
                      "content": "The stalled mark starts after 60 minutes; Retry is available before that."
                    },
                    "G5aTKs/TkEdw/gVPtp": {
                      "content": "export function retry(job: Job) {\n  job.state = \"pending\";\n  job.claimId = crypto.randomUUID();\n}"
                    },
                    "G5aTKs/F8yT4R": {
                      "content": "session.ts"
                    },
                    "G5aTKs/YPm4u": {
                      "content": "Adds the retry transition"
                    },
                    "G5aTKs/z284ra": {
                      "content": "JobRow.tsx"
                    },
                    "G5aTKs/Q4hyh": {
                      "content": "Shows Retry on claimed jobs"
                    },
                    "G5aTKs/sePyj": {
                      "content": "A result submitted with an old claim ID is discarded."
                    }
                  }
                },
                {
                  "type": "frame",
                  "id": "q3a1YD",
                  "name": "conversation",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": "$space-3",
                  "children": [
                    {
                      "type": "text",
                      "id": "In5JF",
                      "name": "heading",
