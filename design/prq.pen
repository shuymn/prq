                      "content": "The stalled mark starts after 60 minutes; Retry is available before that."
                    },
                    "G5aTKs/TkEdw": {
                      "enabled": false
                    },
                    "G5aTKs/TkEdw/gVPtp": {
                      "content": "export function retry(job: Job) {\n  job.state = \"pending\";\n  job.claimId = crypto.randomUUID();\n}"
                    },
                    "G5aTKs/MBzHE": {
                      "enabled": false
                    },
                    "G5aTKs/F8yT4R": {
                      "content": "session.ts"
                    },
                    "G5aTKs/YPm4u": {
                      "content": "Adds the retry transition"
                    },
                    "G5aTKs/z284ra": {
                      "content": "JobRow.tsx"
                    },
                    "G5aTKs/Q4hyh": {
                      "content": "Shows Retry on claimed jobs"
                    },
                    "G5aTKs/nYsib": {
                      "enabled": false
                    },
                    "G5aTKs/sePyj": {
                      "content": "A result submitted with an old claim ID is discarded."
                    }
                  }
                },
                {
                  "type": "frame",
                  "id": "NY7HX",
                  "name": "conversation",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": "$space-3",
                  "children": [
                    {
                      "type": "text",
                      "id": "hYMX4",
                      "name": "heading",
                      "fill": "$color-fg-default",
                      "content": "Conversation",
                      "lineHeight": "$text-heading-line-height",
                      "fontFamily": "$text-heading-font-family",
                      "fontSize": "$text-heading-font-size",
                      "fontWeight": "$text-heading-font-weight"
                    },
                    {
                      "id": "Y6bh2",
                      "type": "ref",
                      "ref": "MqAcS",
                      "name": "Question 1",
                      "width": "fill_container",
                      "descendants": {
                        "TIsFd/qnZ4a": {
                          "content": "35 min ago"
                        },
                        "KHrM8": {
                          "content": "Why does a retry issue a new claim ID instead of reusing the old one?"
                        }
                      }
                    },
                    {
                      "id": "JGxfG",
                      "type": "ref",
                      "ref": "Ron4L",
                      "name": "Answer 1",
                      "width": "fill_container",
                      "descendants": {
                        "cinzx/J91by": {
                          "content": "A new claim ID lets the session drop a late result from the old claim. If the first agent submits after the retry, its claim ID no longer matches and the result is discarded."
                        },
                        "cinzx/TkEdw/gVPtp": {
                          "content": "if (submit.claimId !== job.claimId) {\n  return { status: \"discarded\" };\n}"
                        },
                        "IJ0eN/nVVeD": {
                          "content": "e4f5a6b"
                        },
                        "j8jXQ3": {
                          "content": "deepseek-chat · 2,310 tokens"
                        }
                      }
                    },
                    {
                      "id": "b2OZ4",
                      "type": "ref",
                      "ref": "MqAcS",
                      "name": "Question 2",
                      "width": "fill_container",
                      "descendants": {
                        "TIsFd/qnZ4a": {
                          "content": "5 min ago"
                        },
                        "KHrM8": {
                          "content": "In a1b2c3d, did a retry keep the claim ID?"
                        }
                      }
                    },
                    {
                      "id": "BYfDS",
                      "type": "ref",
                      "ref": "Ron4L",
                      "name": "Answer 2",
                      "width": "fill_container",
                      "descendants": {
                        "cinzx/J91by": {
                          "content": "Yes. At a1b2c3d the retry route only set the job back to pending and kept its claim ID, so a late result from the first agent was still accepted."
                        },
                        "cinzx/TkEdw": {
                          "enabled": false
                        },
                        "IJ0eN/nVVeD": {
                          "content": "a1b2c3d"
                        },
                        "j8jXQ3": {
                          "content": "deepseek-chat · 1,630 tokens"
                        }
                      }
