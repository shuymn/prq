                      "content": "What changed"
                    },
                    "G5aTKs/J91by": {
                      "content": "Claimed jobs can be put back to pending through the API. The UI does not offer Retry yet, and a retried job keeps its claim ID."
                    },
                    "G5aTKs/zBERA": {
                      "enabled": false
                    },
                    "G5aTKs/raSAP": {
                      "content": "Retries go through"
