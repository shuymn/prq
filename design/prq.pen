                      "lineHeight": "$text-heading-line-height",
                      "fontFamily": "$text-heading-font-family",
                      "fontSize": "$text-heading-font-size",
                      "fontWeight": "$text-heading-font-weight"
                    },
                    {
                      "id": "awI7u",
                      "type": "ref",
                      "ref": "MqAcS",
                      "name": "Question 1",
                      "width": "fill_container",
                      "descendants": {
                        "TIsFd/qnZ4a": {
                          "content": "10 min ago"
                        },
                        "KHrM8": {
                          "content": "Why does a retry issue a new claim ID instead of reusing the old one?"
                        }
                      }
                    },
                    {
                      "id": "J4brpk",
                      "type": "ref",
                      "ref": "Ron4L",
                      "name": "Answer 1",
                      "width": "fill_container",
                      "descendants": {
                        "cinzx/J91by": {
                          "content": "A new claim ID lets the session drop a late result from the old claim. If the first agent submits after the retry, its claim ID no longer matches and the result is discarded."
                        },
                        "cinzx/TkEdw/gVPtp": {
                          "content": "if (submit.claimId !== job.claimId) {\n  return { status: \"discarded\" };\n}"
                        },
                        "IJ0eN/nVVeD": {
                          "content": "e4f5a6b"
                        },
                        "j8jXQ3": {
                          "content": "deepseek-chat · 2,310 tokens"
                        }
                      }
                    },
                    {
                      "id": "YiSHR",
                      "type": "ref",
                      "ref": "MqAcS",
                      "name": "Question 2",
                      "width": "fill_container",
                      "descendants": {
                        "TIsFd/qnZ4a": {
                          "content": "4 min ago"
                        },
                        "KHrM8": {
                          "content": "Can I retry before the 60-minute stalled mark?"
                        }
                      }
                    },
                    {
                      "id": "qBIaN",
                      "type": "ref",
                      "ref": "Ron4L",
                      "name": "Answer 2",
                      "width": "fill_container",
                      "descendants": {
                        "cinzx/J91by": {
                          "content": "Yes. Retry is available on any claimed or failed job at any time. The stalled mark only tells you that a claimed job has had no result for 60 minutes."
                        },
                        "cinzx/TkEdw": {
                          "enabled": false
                        },
