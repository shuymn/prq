// Unused files, dependencies and exports (`pnpm run knip`, CI's Check job). Entries the plugins find (the vitest
// config, lefthook, oxlint, commitlint) are not listed again; the rest are below, each with what loads it.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Linux's access control list tool, which the setup's tests use where the machine has it (not macOS).
  "ignoreBinaries": ["setfacl"],
  "workspaces": {
    ".": {
      // The design scripts, run by hand (`node design/*.mjs`) or through the Pencil MCP `execute` tool
      // (design/README.md), and the types the web UI's gallery check reads inventory.mjs with.
      "entry": ["design/*.{js,mjs}", "design/inventory.d.mts"],
    },
    "packages/server": {
      // The component gallery's page, which src/client/gallery/gallery.html loads (`vite build --mode gallery`), and
      // the operations scripts' test entry, which their tests start by path.
      "entry": ["src/client/gallery/main.tsx", "scripts/test-entry.ts"],
    },
    "packages/cli": {
      // The binary's entry (the default, kept when an entry is listed), and the local stack's worker process, which
      // src/test/local-stack.ts starts by path.
      "entry": ["src/main.ts", "src/test/local-stack-child.ts"],
    },
  },
}
